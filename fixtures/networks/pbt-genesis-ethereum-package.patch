+def precompute_el_genesis_block(
+    plan,
+    generator_image,
+    generator_files,
+    el_image,
+    el_params,
+    tolerations,
+    global_node_selectors,
+):
+    """Compute the execution genesis block with a real EL client.
+
+    Returns (el_genesis_artifact, precomputed_block_artifact). The block
+    artifact holds a single `latest_block.json` in JSON-RPC-response-envelope
+    form, which is what `eth-genesis-state-generator --shadow-fork-block`
+    expects.
+    """
+    el_genesis = plan.run_sh(
+        name="generate-el-genesis-only",
+        description="Creating the execution genesis, ahead of the beacon genesis",
+        run="cp /opt/values.env /config/values.env && ./entrypoint.sh el",
+        image=generator_image,
+        files=generator_files,
+        store=[StoreSpec(src="/data/metadata/", name="el_genesis_only")],
+        wait=None,
+        tolerations=tolerations,
+        node_selectors=global_node_selectors,
+    )
+    el_genesis_artifact = el_genesis.files_artifacts[0]
+
+    plan.add_service(
+        name=PRECOMPUTED_EL_SERVICE_NAME,
+        config=ServiceConfig(
+            image=el_image,
+            ports={
+                PRECOMPUTED_EL_RPC_PORT_ID: PortSpec(
+                    number=PRECOMPUTED_EL_RPC_PORT_NUM,
+                    transport_protocol="TCP",
+                    application_protocol="http",
+                    wait="60s",
+                ),
+            },
+            files={"/genesis": el_genesis_artifact},
+            cmd=[
+                "--network",
+                "/genesis/genesis.json",
+                "--http.addr",
+                "0.0.0.0",
+                "--http.port",
+                str(PRECOMPUTED_EL_RPC_PORT_NUM),
+                "--datadir",
+                "/tmp/precompute",
+            ]
+            + el_params,
+            tolerations=tolerations,
+            node_selectors=global_node_selectors,
+        ),
+    )
+
+    block = plan.run_sh(
+        name="read-el-genesis-block",
+        description="Reading the execution genesis block from the EL",
+        run="mkdir -p /out; for i in $(seq 1 60); do "
+        + "curl -s -X POST -H 'Content-Type: application/json' --data '"
+        + '{"jsonrpc":"2.0","id":1,"method":"eth_getBlockByNumber","params":["0x0",false]}'
+        + "' http://"
+        + PRECOMPUTED_EL_SERVICE_NAME
+        + ":"
+        + str(PRECOMPUTED_EL_RPC_PORT_NUM)
+        + " > /out/"
+        + PRECOMPUTED_BLOCK_FILENAME
+        + "; if jq -e .result.hash /out/"
+        + PRECOMPUTED_BLOCK_FILENAME
+        + " > /dev/null 2>&1; then break; fi; sleep 2; done; jq -r .result.hash /out/"
+        + PRECOMPUTED_BLOCK_FILENAME
+        + " | tr -d '\\n'",
+        image=generator_image,
+        store=[StoreSpec(src="/out/", name="precomputed_el_genesis_block")],
+        wait=None,
+        tolerations=tolerations,
+        node_selectors=global_node_selectors,
+    )
+    plan.print("Pre-computed EL genesis block: {0}".format(block.output))
+
+    plan.remove_service(PRECOMPUTED_EL_SERVICE_NAME)
+
+    return el_genesis_artifact, block.files_artifacts[0]
+
+
